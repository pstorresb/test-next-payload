# Payload / Next.js
DATABASE_URL=postgresql://payload:change-me@localhost:5432/payload_real_estate
PAYLOAD_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Docker Compose (used to create the local PostgreSQL container)
POSTGRES_DB=payload_real_estate
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me

# Initial admin created by `npm run seed`
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=change-this-admin-password
